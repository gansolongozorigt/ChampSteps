{
  "name": "champstep",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b",
    "lint:api": "tsc -p tsconfig.api.json --noEmit",
    "test:rules": "firebase emulators:exec --only firestore,storage --project champstep-rules-test \"node --test --test-concurrency=1 tests/rules/firestore.test.mjs tests/rules/storage.test.mjs tests/rules/legacy-user.test.mjs tests/rules/goals.test.mjs\"",
    "test:rules:api": "node tests/rules/api-runner.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report scratch/qa-20261007/report",
    "test:plans": "node --test tests/plans.test.mjs",
    "test:pdf": "node --import tsx --test tests/pdf-templates.test.mjs",
    "test:export": "node --import tsx --test tests/export-data.test.mjs",
    "test:goals": "node --import tsx --test tests/goals.test.mjs",
    "test:api": "node --test tests/ai-insight-cors.test.mjs tests/ai-insight-prompt.test.mjs tests/subscription-math.test.mjs tests/deletion.test.mjs tests/promo.test.mjs tests/qpay-token.test.mjs tests/qpay-callback.test.mjs tests/push.test.mjs tests/streak.test.mjs",
    "cap:sync": "vite build --mode native && cap sync",
    "cap:ios": "npm run cap:sync && cap run ios",
    "cap:android": "npm run cap:sync && cap run android",
    "cap:assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#FFFFFF' --iconBackgroundColorDark '#FFFFFF' --splashBackgroundColor '#FFFFFF' --splashBackgroundColorDark '#FFFFFF'",
    "cap:bump": "node scripts/cap-bump.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.7.15",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "firebase-tools": "^15.31.0",
    "postcss": "^8.4.39",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-pwa": "^1.3.0"
  }
}
