# ---------------------------------------------------------------------------
# ChampStep — environment variables
# .env* файлууд git-д орохгүй. Утгыг Vercel → Settings → Environment Variables-д тавина.
# ---------------------------------------------------------------------------

# --- Frontend (Vite, build үед bundle-д орно) --------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# "true" үед захиалгын модалд "Туршилт: төлсөн гэж тооц" товч гарна (production-д тавихгүй)
VITE_QPAY_SANDBOX=true

# --- Serverless (api/) -------------------------------------------------------
ANTHROPIC_API_KEY=
# /api/ai-insight model (default claude-sonnet-5-5). Set to override, e.g. claude-sonnet-4-6.
AI_INSIGHT_MODEL=
# E2E only — never set in production: the handler echoes the prompt JSON instead of calling Anthropic.
# AI_INSIGHT_MOCK=1

# QPay v2 — sandbox: https://merchant-sandbox.qpay.mn · production: https://merchant.qpay.mn
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# 32 тэмдэгт санамсаргүй: openssl rand -hex 16
QPAY_CALLBACK_SECRET=
# Callback URL-ийн үндэс (эцэст нь / байхгүй)
APP_URL=https://www.champstep.mn

# Firebase service account JSON-ийг base64 болгосон: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_B64=

# --- Deploy ------------------------------------------------------------------
# FIREBASE_TOKEN (firebase login:ci) — deprecated, use `npx firebase-tools login` for deploys.
# Rules deploy-ийг interactive терминалаас хий: storage.rules нь firestore.get() хэрэглэдэг тул
# CLI "Grant the new role?" гэж асууна (roles/firebaserules.firestoreServiceAgent). Non-interactive
# горимд энэ шалгалт алгасагдаж, Storage бүх хүсэлтэд 403 өгнө. Rollback: scratch/rollback-rules-*.sh

# Promo кодын админ (/api/promo/admin) — зөвхөн энэ email-тэй, баталгаажсан Firebase хэрэглэгч
ADMIN_EMAIL=
