# ---------------------------------------------------------------------------
# ChampStep — environment variables
# .env* файлууд git-д орохгүй. Утгыг Vercel → Settings → Environment Variables-д тавина.
# ---------------------------------------------------------------------------

# --- Frontend (Vite, build үед bundle-д орно) --------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# "true" үед захиалгын модалд "Туршилт: төлсөн гэж тооц" товч гарна (production-д тавихгүй)
VITE_QPAY_SANDBOX=true

# --- Serverless (api/) -------------------------------------------------------
ANTHROPIC_API_KEY=

# QPay v2 — sandbox: https://merchant-sandbox.qpay.mn · production: https://merchant.qpay.mn
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# 32 тэмдэгт санамсаргүй: openssl rand -hex 16
QPAY_CALLBACK_SECRET=
# Callback URL-ийн үндэс (эцэст нь / байхгүй)
APP_URL=https://www.champstep.mn

# Firebase service account JSON-ийг base64 болгосон: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_B64=
